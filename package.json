{
  "name": "kritica",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @kritica/db db:generate",
    "db:migrate": "pnpm --filter @kritica/db db:migrate",
    "db:seed": "pnpm --filter @kritica/db db:seed",
    "db:studio": "pnpm --filter @kritica/db db:studio"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.16.1"
}
